<h1>Add Steam Game</h1>

<form asp-action="ImportGame" asp-controller="Steam" method="post">
    <label for="appId">Game AppId</label>

    <input type="number"
           id="appId"
           name="appId"
           class="form-control" />

    <br />

    <button type="submit"
            class="btn btn-primary">
        Search
    </button>
</form>
	