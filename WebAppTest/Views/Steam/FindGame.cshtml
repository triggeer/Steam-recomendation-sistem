<h1>Найти игру</h1>

<form asp-action="GameDetails"
      asp-controller="Steam"
      method="get">

    <label for="appId">Game AppId</label>

    <input type="number"
           id="appId"
           name="appId"
           class="form-control" />

    <br />

    <button type="submit"
            class="btn btn-primary">
        Search
    </button>

</form>


<h1>Сформировать вектор силы тегов</h1>
<form asp-action="FormGameTagsVector" asp-controller="Steam" method="get">
    <label for="gameId">game Id</label>

    <input type="text"
           id="gameId"
           name="gameId"
           class="form-control" />

    <br />

    <button type="submit"
            class="btn btn-primary">
        Search
    </button>
</form>



