<h1>Find Steam Game</h1>

<form asp-action="GameDetails"
      asp-controller="Steam"
      method="get">

    <label for="appId">Game AppId</label>

    <input type="number"
           id="appId"
           name="appId"
           class="form-control" />

    <br />

    <button type="submit"
            class="btn btn-primary">
        Search
    </button>

</form>
