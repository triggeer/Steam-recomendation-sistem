<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Steam Recommendations</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/WebAppTest.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header class="site-header">
        <nav class="site-navbar">

            <div class="navbar-container">

                <a class="site-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    Steam Recommendations
                </a>


                <button class="navbar-toggle"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Открыть меню">
                    ☰
                </button>


                <div class="navbar-menu collapse"
                     id="mainNavigation">

                    <ul class="navbar-links">

                        <li>
                            <a asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Главная
                            </a>
                        </li>

                        <li>
                            <a asp-area=""
                               asp-controller="Recommendation"
                               asp-action="Index">
                                Рекомендации
                            </a>
                        </li>

                        <li>
                            <a asp-area=""
                               asp-controller="Recommendation"
                               asp-action="ShowPreviousLists">
                                Мои списки
                            </a>
                        </li>

                    </ul>


                    <ul class="navbar-links technical-links">

                        <li>
                            <a asp-area=""
                               asp-controller="Steam"
                               asp-action="AddGame">
                                Добавить игру
                            </a>
                        </li>

                        <li>
                            <a asp-area=""
                               asp-controller="Steam"
                               asp-action="FindGame">
                                Данные
                            </a>
                        </li>

                        <li>
                            <a asp-area=""
                               asp-controller="Steam"
                               asp-action="Get100ID">
                                Импорт
                            </a>
                        </li>

                        <li>
                            <a asp-area=""
                               asp-controller="Steam"
                               asp-action="UpdateData">
                                Обновить данные
                            </a>
                        </li>

                        <li>
                            <a asp-area=""
                               asp-controller="Steam"
                               asp-action="UpdateGamesImg">
                                Изображения
                            </a>
                        </li>

                    </ul>

                </div>

            </div>

        </nav>
    </header>


    <main class="site-main">
        @RenderBody()
    </main>


    <footer class="site-footer">
        <div class="footer-container">
            <span>
                © 2026 Steam Recommendations
            </span>
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
