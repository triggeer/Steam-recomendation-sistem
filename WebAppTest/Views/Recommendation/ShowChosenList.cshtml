@model WebAppTest.Models.Game

<head>
	@{
			ViewData["Title"] = "Предыдущие списки";
	}
</head>

<body>
	<h1>@Model.Name</h1>

	<p>
		@Html.Raw(Model.DetailedDescription)
	</p>

	<form asp-controller="Recommendation" 
		asp-action="ShowChosenList"
		method="get">
		<input type="hidden" name="listId" value="@ViewBag.ListId" />
		<input type="hidden" name="index" value="@(ViewBag.Index + 1)" />

		<button type="submit" class="btn btn-primary">
			next
		</button>
	</form>
</body>